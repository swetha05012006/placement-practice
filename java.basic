how to get user input
1.import java.util.Scanner;
   
   class Main{
       public static void main(String args[])
       {
           Scanner star = new Scanner(System.in);
           int a = star.nextInt();
           int b = star.nextInt();
           System.out.print(a+b);
       }
   }
